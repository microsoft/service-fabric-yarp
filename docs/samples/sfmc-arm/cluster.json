{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "_generator": {
            "purpose": "Starter template for deploying SFYarp 2.0.0 onto a fresh Service Fabric managed cluster (SFMC).",
            "notes": [
                "SFYarp 2.0.0 is self-contained on .NET 10 - no runtime install or CustomScriptExtension is required.",
                "KVVMExtension is ordered with setupOrder=BeforeSFRuntime and requireInitialSync=true so the endpoint TLS cert is installed on every node before SFYarp starts.",
                "The application name is fixed to 'YarpProxyApp' (fabric:/YarpProxyApp) because YarpProxy.Service uses that name to discover FabricDiscovery.Service."
            ]
        }
    },
    "parameters": {
        "adminPassword": {
            "type": "securestring"
        },
        "adminUsername": {
            "type": "string"
        },
        "certUrlVersionless": {
            "type": "string",
            "metadata": {
                "description": "Versionless Key Vault secret URL for the endpoint TLS cert used by SFYarp for SNI (e.g. https://<kv>.vault.azure.net/secrets/<cert-name>). Deployed to LocalMachine\\My by the KV VM extension."
            }
        },
        "clientCertificateThumbprint": {
            "type": "string",
            "metadata": {
                "description": "Thumbprint of the client certificate used for cluster admin access."
            }
        },
        "clusterName": {
            "type": "string"
        },
        "clusterSku": {
            "type": "string",
            "allowedValues": [
                "Basic",
                "Standard"
            ],
            "defaultValue": "Standard"
        },
        "dataDiskSizeGB": {
            "type": "int",
            "defaultValue": 100
        },
        "dataDiskType": {
            "type": "string",
            "allowedValues": [
                "Standard_LRS",
                "StandardSSD_LRS",
                "Premium_LRS"
            ],
            "defaultValue": "StandardSSD_LRS"
        },
        "dnsName": {
            "type": "string"
        },
        "endpointCertSubject": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Subject name of the endpoint TLS cert (e.g. cn=<clusterFqdn>). SFYarp picks the cert from LocalMachine\\My by subject at SNI time. Preferred over endpointCertThumbprint because it survives certificate rotation."
            }
        },
        "endpointCertThumbprint": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Optional thumbprint fallback for endpoint TLS cert selection. Leave empty when using endpointCertSubject."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]"
        },
        "nodeCount": {
            "type": "int",
            "defaultValue": 5
        },
        "nodeTypeName": {
            "type": "string",
            "defaultValue": "nt",
            "maxLength": 9
        },
        "uamiResourceId": {
            "type": "string",
            "metadata": {
                "description": "Resource ID of a user-assigned managed identity granted 'Key Vault Secrets User' on the Key Vault referenced by certUrlVersionless. Used by the KV VM extension to pull secrets."
            }
        },
        "vmImageOffer": {
            "type": "string",
            "defaultValue": "WindowsServer"
        },
        "vmImagePublisher": {
            "type": "string",
            "defaultValue": "MicrosoftWindowsServer"
        },
        "vmImageSku": {
            "type": "string",
            "defaultValue": "2022-datacenter-azure-edition"
        },
        "vmImageVersion": {
            "type": "string",
            "defaultValue": "latest"
        },
        "vmSize": {
            "type": "string",
            "defaultValue": "Standard_D2s_v5"
        },
        "yarpAppTypeVersion": {
            "type": "string",
            "defaultValue": "2.0.0",
            "metadata": {
                "description": "SFYarp application type version. Must match the version declared inside the sfpkg's ApplicationManifest.xml."
            }
        },
        "yarpHttpPort": {
            "type": "int",
            "defaultValue": 8080
        },
        "yarpHttpsPort": {
            "type": "int",
            "defaultValue": 443
        },
        "yarpInstanceCount": {
            "type": "string",
            "defaultValue": "-1",
            "metadata": {
                "description": "Instance count for YarpProxy and FabricDiscovery. '-1' means one instance per eligible node."
            }
        },
        "yarpSfpkgUrl": {
            "type": "string",
            "metadata": {
                "description": "HTTPS URL of the YarpProxyApp sfpkg (typically an Azure Storage blob you control). Keep the version in the blob path so previous versions remain reachable for rollback."
            }
        }
    },
    "variables": {
        "sfApiVersion": "2024-04-01",
        "yarpAppTypeName": "YarpProxyAppType",
        "yarpAppName": "YarpProxyApp",
        "clusterFqdn": "[format('{0}.{1}.cloudapp.azure.com', parameters('dnsName'), parameters('location'))]"
    },
    "resources": [
        {
            "type": "Microsoft.ServiceFabric/managedclusters",
            "apiVersion": "[variables('sfApiVersion')]",
            "name": "[parameters('clusterName')]",
            "location": "[parameters('location')]",
            "sku": {
                "name": "[parameters('clusterSku')]"
            },
            "properties": {
                "dnsName": "[parameters('dnsName')]",
                "adminUserName": "[parameters('adminUsername')]",
                "adminPassword": "[parameters('adminPassword')]",
                "clientConnectionPort": 19000,
                "httpGatewayConnectionPort": 19080,
                "clusterUpgradeMode": "Automatic",
                "clusterUpgradeCadence": "Wave1",
                "clients": [
                    {
                        "isAdmin": true,
                        "thumbprint": "[parameters('clientCertificateThumbprint')]"
                    }
                ],
                "loadBalancingRules": [
                    {
                        "frontendPort": "[parameters('yarpHttpsPort')]",
                        "backendPort": "[parameters('yarpHttpsPort')]",
                        "protocol": "tcp",
                        "probeProtocol": "tcp",
                        "probePort": "[parameters('yarpHttpsPort')]"
                    },
                    {
                        "frontendPort": "[parameters('yarpHttpPort')]",
                        "backendPort": "[parameters('yarpHttpPort')]",
                        "protocol": "tcp",
                        "probeProtocol": "tcp",
                        "probePort": "[parameters('yarpHttpPort')]"
                    }
                ]
            }
        },
        {
            "type": "Microsoft.ServiceFabric/managedclusters/nodetypes",
            "apiVersion": "[variables('sfApiVersion')]",
            "name": "[format('{0}/{1}', parameters('clusterName'), parameters('nodeTypeName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.ServiceFabric/managedclusters', parameters('clusterName'))]"
            ],
            "properties": {
                "isPrimary": true,
                "vmSize": "[parameters('vmSize')]",
                "vmInstanceCount": "[parameters('nodeCount')]",
                "dataDiskSizeGB": "[parameters('dataDiskSizeGB')]",
                "dataDiskType": "[parameters('dataDiskType')]",
                "vmImagePublisher": "[parameters('vmImagePublisher')]",
                "vmImageOffer": "[parameters('vmImageOffer')]",
                "vmImageSku": "[parameters('vmImageSku')]",
                "vmImageVersion": "[parameters('vmImageVersion')]",
                "vmManagedIdentity": {
                    "userAssignedIdentities": [
                        "[parameters('uamiResourceId')]"
                    ]
                },
                "vmExtensions": [
                    {
                        "name": "KVVMExtension",
                        "properties": {
                            "publisher": "Microsoft.Azure.KeyVault",
                            "type": "KeyVaultForWindows",
                            "typeHandlerVersion": "3.0",
                            "autoUpgradeMinorVersion": true,
                            "provisionAfterExtensions": [
                                "SfmcSetupVmExt"
                            ],
                            "setupOrder": [
                                "BeforeSFRuntime"
                            ],
                            "settings": {
                                "secretsManagementSettings": {
                                    "pollingIntervalInS": "300",
                                    "certificateStoreName": "My",
                                    "certificateStoreLocation": "LocalMachine",
                                    "linkOnRenewal": true,
                                    "requireInitialSync": true,
                                    "observedCertificates": [
                                        "[parameters('certUrlVersionless')]"
                                    ]
                                }
                            }
                        }
                    }
                ]
            }
        },
        {
            "type": "Microsoft.ServiceFabric/managedclusters/applicationTypes",
            "apiVersion": "[variables('sfApiVersion')]",
            "name": "[format('{0}/{1}', parameters('clusterName'), variables('yarpAppTypeName'))]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.ServiceFabric/managedclusters/nodetypes', parameters('clusterName'), parameters('nodeTypeName'))]"
            ]
        },
        {
            "type": "Microsoft.ServiceFabric/managedclusters/applicationTypes/versions",
            "apiVersion": "[variables('sfApiVersion')]",
            "name": "[format('{0}/{1}/{2}', parameters('clusterName'), variables('yarpAppTypeName'), parameters('yarpAppTypeVersion'))]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.ServiceFabric/managedclusters/applicationTypes', parameters('clusterName'), variables('yarpAppTypeName'))]"
            ],
            "properties": {
                "appPackageUrl": "[parameters('yarpSfpkgUrl')]"
            }
        },
        {
            "type": "Microsoft.ServiceFabric/managedclusters/applications",
            "apiVersion": "[variables('sfApiVersion')]",
            "name": "[format('{0}/{1}', parameters('clusterName'), variables('yarpAppName'))]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.ServiceFabric/managedclusters/applicationTypes/versions', parameters('clusterName'), variables('yarpAppTypeName'), parameters('yarpAppTypeVersion'))]"
            ],
            "properties": {
                "version": "[resourceId('Microsoft.ServiceFabric/managedclusters/applicationTypes/versions', parameters('clusterName'), variables('yarpAppTypeName'), parameters('yarpAppTypeVersion'))]",
                "parameters": {
                    "YarpProxy_HttpPort": "[string(parameters('yarpHttpPort'))]",
                    "YarpProxy_HttpsPort": "[string(parameters('yarpHttpsPort'))]",
                    "YarpProxy_InstanceCount": "[parameters('yarpInstanceCount')]",
                    "FabricDiscovery_InstanceCount": "[parameters('yarpInstanceCount')]",
                    "EndpointCertSubject": "[parameters('endpointCertSubject')]",
                    "EndpointCertThumbprint": "[parameters('endpointCertThumbprint')]"
                }
            }
        }
    ],
    "outputs": {
        "clusterFqdn": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.ServiceFabric/managedclusters', parameters('clusterName'))).fqdn]"
        },
        "yarpHttpsUrl": {
            "type": "string",
            "value": "[format('https://{0}:{1}', variables('clusterFqdn'), parameters('yarpHttpsPort'))]"
        },
        "yarpHttpUrl": {
            "type": "string",
            "value": "[format('http://{0}:{1}', variables('clusterFqdn'), parameters('yarpHttpPort'))]"
        }
    }
}
